# Copy to .env and adjust. Loaded automatically when running the server.

PORT=8787

# Postgres connection string. When unset, the server starts an embedded
# Postgres (PGlite) for zero-setup local development.
# Examples:
#   Neon:      postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase:  postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#   Local:     postgresql://postgres:postgres@localhost:5432/neuralvault
# DATABASE_URL=postgresql://...

JWT_SECRET=change-me-to-a-long-random-string

# Demo mode credits wallet deposits instantly (no payment provider needed).
# Set to false to require Stripe checkout for deposits.
DEMO_MODE=true

# Uncomment to enable real Stripe checkout deposits + webhook crediting.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Comma-separated origins allowed by CORS (defaults to all).
# CORS_ORIGIN=*
